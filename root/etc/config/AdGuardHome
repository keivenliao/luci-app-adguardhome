config AdGuardHome 'AdGuardHome'
	option enabled '0'
	option httpport '3000'
	option redirect 'none'
	option configpath '/etc/AdGuardHome/config.yaml'
	option workdir '/etc/AdGuardHome/workspace'
	option logfile '/tmp/AdGuardHome.log'
	option verbose '0'
	option binpath '/etc/AdGuardHome/AdGuardHome'
	option upxflag ''

